    "keywords": "serializable,serialize,deserialize,json,property,properties,command,commands,espressio",
    "authors": {
        "name": "Flowduino",
        "maintainer": true
    },
    "build": {
        "flags": [
            "-DESPRESSIO_SERIALIZABLE"
        ],
        "unflags": []
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Flowduino/ESPressio-Serializable.git"
    },
    "version": "0.0.1",
    "license": "Apache-2.0",
    "frameworks": "arduino,espressif32",
    "platforms": "*",
    "dependencies": [
        {
            "name": "ArduinoJson",
            "version": "7.0.3",
            "url": "https://github.com/bblanchon/ArduinoJson.git",
            "platforms": "*"
        },
        {
            "name": "Flowduino ESPressio-Tree",
            "version": "0.0.1",
            "url": "https://github.com/Flowduino/ESPressio-Tree.git",
            "platforms": "*"
        }
    ]
}